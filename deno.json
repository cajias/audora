{
  "name": "audora",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^0.218.2"
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-run --allow-env --allow-ffi --unstable-ffi cli.ts"
  }
}