{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom"]
  },
  "tasks": {
    "dev": "deno run --watch main.ts",
    "lint": "deno lint",
    "format": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "workspace": ["./packages/osx-audio"],
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 120,
      "indentWidth": 2,
      "singleQuote": false,
      "semiColons": true
    }
  }
}
